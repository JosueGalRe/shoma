# Mimic Web — Variables de entorno
# Estas variables son inyectadas por Vite en build time.
# Deben empezar con VITE_ para estar disponibles en import.meta.env.

# URL base del servidor Rift (WebSocket)
# Ejemplo producción: wss://rift.mimic.lol
# Default local: ws://localhost:51001
VITE_RIFT_WS_BASE_URL=

# URL base del servidor Rift (HTTP)
# Ejemplo producción: https://rift.mimic.lol
# Default local: http://localhost:51001
VITE_RIFT_HTTP_BASE_URL=
