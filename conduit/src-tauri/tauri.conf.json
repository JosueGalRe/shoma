{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sho'ma Conduit",
  "version": "0.1.0",
  "identifier": "com.shoma.conduit",
  "build": {
    "beforeDevCommand": {
      "script": "bunx vite --host 127.0.0.1 --port 1420 --strictPort",
      "cwd": "../"
    },
    "beforeBuildCommand": "bunx vite build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sho'ma Conduit",
        "label": "main",
        "decorations": false,
        "width": 400,
        "height": 320,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {}

}
