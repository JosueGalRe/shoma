{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shoma Conduit",
  "version": "0.1.11",
  "identifier": "com.shoma.conduit",
  "build": {
    "beforeDevCommand": {
      "script": "bunx vite --host 127.0.0.1 --port 1420 --strictPort",
      "cwd": "../"
    },
    "beforeBuildCommand": {
      "script": "pnpm exec vp build",
      "cwd": "../"
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sho'ma Conduit",
        "label": "main",
        "decorations": false,
        "width": 480,
        "height": 400,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2NTREQTNGQ0Y5QzVBOTYKUldTV1dwelBQOXBVWmhZbmR0OHJ6MWovaU8wWWVpek5GQ2JhMWFUK0tzUGxnbkdGTFYzYUlvelUK",
      "endpoints": ["https://github.com/JosueGalRe/shoma/releases/latest/download/latest.json"]
    }
  }
}
