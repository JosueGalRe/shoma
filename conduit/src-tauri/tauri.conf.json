{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shoma Conduit",
  "version": "0.1.0",
  "identifier": "com.shoma.conduit",
  "build": {
    "beforeDevCommand": {
      "script": "bunx vite --host 127.0.0.1 --port 1420 --strictPort",
      "cwd": "../"
    },
    "beforeBuildCommand": {
      "script": "pnpm exec vp build",
      "cwd": "../"
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sho'ma Conduit",
        "label": "main",
        "decorations": false,
        "width": 400,
        "height": 320,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyMDNDQTRFNEJCQzUwNzQKUldSMFVMeExUc29Ec21jS2pTZTRGZEg3Ni9ybjhuZnMvekFzUEcyTFl4MXNOU1hQckZNMVV5K0EK",
      "endpoints": [
        "https://github.com/JosueGalRe/shoma/releases/latest/download/latest.json"
      ]
    }
  }
}
