{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@core/*": ["src/core/*"],
      "@features/*": ["src/features/*"],
      "@routes/*": ["src/routes/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
