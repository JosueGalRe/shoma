{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["bun", "vite/client"],
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@core/*": ["./src/core/*"],
      "@features/*": ["./src/features/*"],
      "@routes/*": ["./src/routes/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts"]
}
