# Sho'ma Loom — Variables de entorno
# Estas variables son inyectadas por Vite en build time.
# Deben empezar con VITE_ para estar disponibles en import.meta.env.

# URL base del servidor Leyline (WebSocket)
# Ejemplo producción: wss://leyline.shoma.lol
# Default local: ws://localhost:51001
VITE_LEYLINE_WS_BASE_URL=

# URL base del servidor Leyline (HTTP)
# Ejemplo producción: https://leyline.shoma.lol
# Default local: http://localhost:51001
VITE_LEYLINE_HTTP_BASE_URL=
