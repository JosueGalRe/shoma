{
  "name": "mimic-mono",
  "private": true,
  "workspaces": [
    "web",
    "rift",
    "conduit",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "fmt": "bunx oxfmt .",
    "fmt:check": "bunx oxfmt --check .",
    "lint": "bun run lint:ox && bun run lint:eslint",
    "lint:ox": "bunx oxlint --config oxlint.config.ts web rift conduit packages",
    "lint:eslint": "vp lint --max-warnings=0 web rift packages/protocol-contract",
    "doctor:react": "bunx react-doctor --offline --yes .",
    "doctor:react:json": "bunx react-doctor --json --offline --yes .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "node -e \"if(!process.env.CI&&!process.env.VERCEL){try{require('child_process').execSync('effect-language-service patch',{stdio:'inherit'})}catch(e){process.exit(1)}}\"",
    "doctor:react:check": "bun run scripts/react-doctor-check.ts",
    "dev:rift": "bun run --filter @mimic/rift dev",
    "dev:web": "bun run --filter @mimic/web dev",
    "build:web": "bun run --filter @mimic/web build"
  },
  "reactDoctor": {
    "projects": [
      "web",
      "conduit"
    ],
    "scoreThreshold": 75
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-router": "^1.161.6",
    "@types/bun": "^1.3.13",
    "effect": "4.0.0-beta.65",
    "effect-solutions": "^0.5.3",
    "eslint-plugin-oxlint": "^1.62.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "playwright-core": "^1.59.1",
    "react-doctor": "^0.1.2",
    "shadcn": "^4.6.0",
    "typescript-eslint": "^8.59.1",
    "vite-plus": "^0.1.20"
  },
  "packageManager": "bun@1.1.38",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
