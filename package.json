{
  "name": "mimic-mono",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "fmt": "bunx oxfmt .",
    "fmt:check": "bunx oxfmt --check .",
    "lint": "bun run lint:ox && bun run lint:eslint",
    "lint:ox": "bunx oxlint --config oxlint.config.ts apps packages",
    "lint:eslint": "vp lint --max-warnings=0 apps/web-next apps/rift-next packages/protocol-contract",
    "dev:rift-next": "bun run --filter @mimic/rift-next dev",
    "dev:web-next": "bun run --filter @mimic/web-next dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-router": "^1.161.6",
    "@types/bun": "^1.3.13",
    "eslint-plugin-oxlint": "^1.62.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "playwright-core": "^1.59.1",
    "shadcn": "^4.6.0",
    "typescript-eslint": "^8.59.1",
    "vite-plus": "^0.1.20"
  },
  "packageManager": "bun@1.1.38",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
