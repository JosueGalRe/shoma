{
  "name": "shoma",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "fmt": "pnpm exec oxfmt .",
    "fmt:check": "pnpm exec oxfmt --check .",
    "lint": "pnpm run lint:ox && pnpm run lint:eslint",
    "lint:ox": "vp lint loom leyline conduit packages",
    "lint:eslint": "vp lint --max-warnings=0 loom leyline packages/protocol-contract",
    "doctor:react": "pnpm dlx react-doctor --offline --yes .",
    "doctor:react:json": "pnpm dlx react-doctor --json --offline --yes .",
    "typecheck": "pnpm -r run typecheck",
    "prepare": "node -e \"if(!process.env.CI&&!process.env.VERCEL){try{require('child_process').execSync('effect-language-service patch',{stdio:'inherit'})}catch(e){process.exit(1)}}\"",
    "doctor:react:check": "bun scripts/react-doctor-check.ts",
    "dev:leyline": "pnpm --filter @shoma/leyline run dev",
    "dev:loom": "pnpm --filter @shoma/loom run dev",
    "dev:conduit": "pnpm --filter @shoma/conduit run dev",
    "build:loom": "pnpm --filter @shoma/loom run build",
    "build:conduit": "pnpm --filter @shoma/conduit run build",
    "release:conduit": "./scripts/release-conduit.sh"
  },
  "devDependencies": {
    "@effect/language-service": "^0.85.1",
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-router": "^1.161.6",
    "@types/bun": "^1.3.13",
    "effect": "4.0.0-beta.65",
    "effect-solutions": "^0.5.3",
    "eslint-plugin-oxlint": "^1.62.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "playwright": "^1.60.0",
    "playwright-core": "^1.59.1",
    "react-doctor": "^0.1.2",
    "shadcn": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite-plus": "^0.1.20"
  },
  "packageManager": "pnpm@11.1.1",
  "reactDoctor": {
    "projects": [
      "loom",
      "conduit"
    ],
    "scoreThreshold": 75
  }
}
