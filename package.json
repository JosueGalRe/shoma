{
  "name": "shoma",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "fmt": "pnpm run fmt:loom && pnpm run fmt:conduit && pnpm run fmt:leyline && vp fmt --check packages",
    "fmt:loom": "pnpm --filter @shoma/loom fmt",
    "fmt:conduit": "pnpm --filter @shoma/conduit fmt",
    "fmt:leyline": "pnpm --filter @shoma/leyline fmt",
    "lint": "pnpm run lint:ox && pnpm run lint:eslint",
    "lint:ox": "vp lint loom leyline conduit packages",
    "lint:eslint": "vp lint --max-warnings=0 loom leyline packages/protocol-contract",
    "typecheck": "pnpm run typecheck:loom && pnpm run typecheck:conduit && pnpm run typecheck:leyline",
    "typecheck:loom": "pnpm --filter @shoma/loom run typecheck",
    "typecheck:conduit": "pnpm --filter @shoma/conduit run typecheck",
    "typecheck:leyline": "pnpm --filter @shoma/leyline run typecheck",
    "dev:leyline": "pnpm --filter @shoma/leyline run dev",
    "dev:loom": "pnpm --filter @shoma/loom run dev",
    "dev:conduit": "pnpm --filter @shoma/conduit run dev",
    "build:loom": "pnpm --filter @shoma/loom run build",
    "build:conduit": "pnpm --filter @shoma/conduit run build",
    "prepare": "node ./scripts/prepare.js",
    "release:conduit": "./scripts/release-conduit.sh",
    "capture:lcu": "bun scripts/capture-lcu.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@effect/tsgo": "0.67.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "effect-solutions": "^0.5.3",
    "eslint-plugin-perfectionist": "^5.13.0",
    "playwright": "^1.65.0",
    "shadcn": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "runtime": {
      "name": "bun",
      "version": "latest",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0"
}
