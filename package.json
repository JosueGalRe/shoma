{
  "name": "mimic-mono",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "fmt": "bunx oxfmt .",
    "fmt:check": "bunx oxfmt --check .",
    "lint": "bun run lint:ox && bun run lint:eslint",
    "lint:ox": "bunx oxlint --config oxlint.config.ts apps packages",
    "lint:eslint": "eslint --max-warnings=0 apps/web-next apps/rift-next packages/protocol-contract",
    "dev:rift-next": "bun run --filter @mimic/rift-next dev",
    "dev:web-next": "bun run --filter @mimic/web-next dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-router": "^1.161.4",
    "@types/bun": "^1.3.9",
    "eslint": "^10.0.1",
    "eslint-plugin-oxlint": "^1.50.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "playwright-core": "^1.59.1",
    "shadcn": "^3.8.5",
    "typescript-eslint": "^8.56.1"
  },
  "packageManager": "bun@1.1.38"
}
