# syntax=docker/dockerfile:1

# ─────────────────────────────────────────────────────────────
# Builder stage — install deps with pnpm, bundle with Bun
# ─────────────────────────────────────────────────────────────
FROM oven/bun:1.2 AS builder
WORKDIR /build

# Enable pnpm (matches root packageManager field)
RUN corepack enable && corepack prepare pnpm@11.1.1 --activate

# Copy workspace configuration and lockfile
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc* ./

# Copy leyline package manifest
COPY leyline/package.json leyline/

# Copy the only workspace dependency (exports raw TS source)
COPY packages/protocol-contract/package.json packages/protocol-contract/
COPY packages/protocol-contract/src packages/protocol-contract/src

# Install dependencies (pnpm respects workspace:* and frozen-lockfile)
RUN pnpm install --frozen-lockfile

# Bundle leyline + workspace deps into a single executable JS file
RUN cd leyline && \
    bun build src/index.ts \
      --target bun \
      --outfile dist/leyline.js

# ─────────────────────────────────────────────────────────────
# Runtime stage — minimal Bun image + bundle
# ─────────────────────────────────────────────────────────────
FROM oven/bun:1.2-slim AS runtime
WORKDIR /app

# Persistent volume mount point for SQLite
RUN mkdir -p /data

# Copy the single-file bundle from builder
COPY --from=builder /build/leyline/dist/leyline.js .

# Default env (override via Railway dashboard or CLI)
ENV PORT=51001
ENV HOSTNAME=0.0.0.0
ENV LEYLINE_DB_PATH=/data/database.db
ENV LOG_LEVEL=info

EXPOSE 51001

# Use exec form so signals propagate correctly
CMD ["bun", "leyline.js"]
