# syntax=docker/dockerfile:1

FROM node:22-alpine
WORKDIR /app

# Install Bun (runtime for leyline + bun:sqlite)
RUN apk add --no-cache bash curl ca-certificates && \
    curl -fsSL https://bun.sh/install | bash && \
    apk del curl
ENV PATH="/root/.bun/bin:${PATH}"

# Install pnpm (package manager for the monorepo)
RUN npm install -g pnpm@11.1.1

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY leyline/package.json leyline/
COPY packages/protocol-contract/package.json packages/protocol-contract/

RUN pnpm install --frozen-lockfile

COPY leyline/src leyline/src
COPY packages/protocol-contract/src packages/protocol-contract/src

RUN mkdir -p /data

ENV PORT=51001
ENV HOSTNAME=0.0.0.0
ENV LEYLINE_DB_PATH=/data/database.db
ENV LOG_LEVEL=info

EXPOSE 51001

CMD ["bun", "leyline/src/index.ts"]
