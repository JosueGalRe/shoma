# syntax=docker/dockerfile:1

FROM node:22-alpine
WORKDIR /app

# Bun is the runtime for leyline + bun:sqlite; Node is only here for pnpm
COPY --from=oven/bun:1.4.0-alpine /usr/local/bin/bun /usr/local/bin/bun

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
# pnpm follows the root packageManager field so it always matches the lockfile format
RUN npm install -g "$(node -p 'require("./package.json").packageManager.split("+")[0]')" && \
    rm -rf /root/.npm
COPY leyline/package.json leyline/
COPY packages/protocol-contract/package.json packages/protocol-contract/

# Runtime deps of leyline and its workspace deps only. No lifecycle scripts: the root prepare
# (effect-language-service dev patch) is not copied into this image
RUN pnpm install --frozen-lockfile --ignore-scripts --prod --filter "@shoma/leyline..."

COPY leyline/src leyline/src
COPY packages/protocol-contract/src packages/protocol-contract/src

RUN mkdir -p /data

ENV PORT=8080
ENV HOSTNAME=0.0.0.0
ENV LEYLINE_DB_PATH=/data/database.db
ENV LOG_LEVEL=info

EXPOSE 8080

CMD ["bun", "leyline/src/index.ts"]
