# Mimic Rift — Variables de entorno
# Estas variables son leídas por el servidor en runtime via Effect Config.

# REQUIRED: Secreto para firmar/verificar JWT tokens.
# Debe ser una string larga y segura en producción.
LEYLINE_JWT_SECRET=

# Ruta a la base de datos SQLite.
# Default: database.db
LEYLINE_DB_PATH=database.db

# Puerto donde escucha el servidor HTTP/WebSocket.
# Default: 51001
PORT=51001

# Hostname al que se enlaza el servidor.
# Default: 0.0.0.0
HOSTNAME=0.0.0.0

# Nivel de logging: debug | info | warn | error
# Default: info
LOG_LEVEL=info

# Silencia logs durante tests.
# Valores: true | false (vacío = auto-detecta si está en test)
LOG_SILENT_IN_TESTS=
