    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/jsonwebtoken": "^9.0.10",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "catalog:"
  }
